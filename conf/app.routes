# microservice specific routes

GET        /penalty-transactions/:taxRef/:accPeriod                        uk.gov.hmrc.corporationtax.controllers.PenaltiesController.getPenaltyTransactionList(taxRef: Long, accPeriod: Long, endDate: Option[String])

GET        /tax-transactions/:taxRef/:accPeriod                            uk.gov.hmrc.corporationtax.controllers.TaxTransactionsController.getTaxTransactions(taxRef: Long, accPeriod: Long)
GET        /interest-accrual-list/:taxRef/:accPeriod/:interestType         uk.gov.hmrc.corporationtax.controllers.InterestAccrualListController.getInterestAccrualList(taxRef: Long, accPeriod: Long, interestType: String)
GET        /interest-charge-summary/:taxPayerReference                     uk.gov.hmrc.corporationtax.controllers.InterestChargesSummaryController.getInterestChargesSummary(taxPayerReference:Long)
GET        /adjustment-transactions/:taxRef/:accPeriod                     uk.gov.hmrc.corporationtax.controllers.AdjustmentTransactionsController.getAdjustmentTransactions(taxRef: Long, accPeriod: Long)
GET        /administrative-rule/:adminRuleKey                              uk.gov.hmrc.corporationtax.controllers.AdministrationRuleController.getAdminRule(adminRuleKey:String)
GET        /payment-transactions/:taxRef/:accPeriod                            uk.gov.hmrc.corporationtax.controllers.PaymentsController.getPayments(taxRef: Long, accPeriod: Long)
GET        /accounting-period-details/:taxRef/:accPeriod                            uk.gov.hmrc.corporationtax.controllers.AccountingPeriodDetailsController.getAccountingPeriodDetails(taxRef: Long, accPeriod: Long)

GET        /reallocation-to-accounting-period/:taxRef/:accPeriod           uk.gov.hmrc.corporationtax.controllers.ReallocationController.getByAccountingPeriod(taxRef: Long, accPeriod: Long)

GET        /reallocation-from-accounting-period/:taxRef/:accPeriod              uk.gov.hmrc.corporationtax.controllers.ReallocationFromAccPeriodController.getReallocationFromAccPeriod(taxRef: Long, accPeriod: Long)
GET        /total-amount-payment-repayment-reallocation/:taxRef/:accPeriod      uk.gov.hmrc.corporationtax.controllers.PayRepayReallocationController.getTotalAmounts(taxRef: Long, accPeriod: Long)
GET        /repayments/:taxRef/:accPeriod                                       uk.gov.hmrc.corporationtax.controllers.RepaymentsController.getRepayments(taxRef: Long, accPeriod: Long)

GET        /accounting-periods/:taxRef                                         uk.gov.hmrc.corporationtax.controllers.AccountingPeriodsController.getAccountingPeriods(taxRef: Long)
GET        /statute-rule             uk.gov.hmrc.corporationtax.controllers.StatuteRuleController.getStatueRule(queryParams: uk.gov.hmrc.corporationtax.queryParams.StatuteQueryParams)